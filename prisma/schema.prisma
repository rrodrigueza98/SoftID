// ─────────────────────────────────────────────────────────────────────────
// RJRA ERP — Modelo de datos
// Sistema de gestion contable / ERP adaptado a la normativa paraguaya (SET / SIFEN)
//
// Modulos cubiertos en esta v1:
//   1. Empresa / Establecimientos / Puntos de expedicion / Timbrados / Usuarios
//   2. Terceros (Clientes y Proveedores)
//   3. Productos y Stock (kardex por deposito)
//   4. Cuentas corrientes (saldos, movimientos, recibos de cobro/pago)
//   5. Comprobantes de venta/compra + Documento Electronico (SIFEN / e-Kuatia)
//
// NOTA: el modulo de Plan de Cuentas / Libro Diario (contabilidad general de
// partida doble) se deja para una fase 2, una vez validados estos modulos.
// Varios catalogos de SIFEN (motivos de emision, formas de pago, tipos de
// documento) se modelan como enum con los valores mas comunes; hay que
// contrastarlos con el Manual Tecnico vigente de SIFEN antes de integrar.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum TipoContribuyente {
  FISICA
  JURIDICA
}

/// Regimen tributario del contribuyente ante la SET (categoria de IRE).
/// IRE_GENERAL implica ademas la obligacion de IVA general (10%/5%), que no
/// se modela como regimen aparte. Confirmado con el usuario: la empresa
/// principal opera en IRE_GENERAL. Ajustar/ampliar si se suma una empresa
/// con otro regimen.
enum RegimenTributario {
  IRE_GENERAL
  IRE_SIMPLE
  IRE_RESIMPLE
}

/// Catalogo del receptor (campo D208 iTipIDRec, corregido en NT_E_KUATIA 002/023/027).
/// RUC se maneja aparte (campo D206 dRucRec) cuando el receptor es contribuyente;
/// este catalogo aplica cuando el receptor NO es contribuyente o es innominado.
enum TipoDocumentoIdentidad {
  RUC
  CEDULA_PARAGUAYA // 1
  PASAPORTE // 2
  CEDULA_EXTRANJERA // 3
  CARNET_RESIDENCIA // 4
  INNOMINADO // 5 -- consumidor final sin identificar; no valido para operaciones >= el umbral vigente (Art. 6 Decreto 872/2023, ajustado por NT024)
  TARJETA_DIPLOMATICA // 6 -- Tarjeta Diplomatica de exoneracion fiscal
  OTRO // 9
}

enum TipoTercero {
  CLIENTE
  PROVEEDOR
  AMBOS
}

/// Forma de afectacion tributaria del IVA (campo E731 iAfecIVA / Tabla 6 del
/// Manual Tecnico SIFEN v150, pag. 212). OJO: esto NO es la tasa -- es
/// independiente de ella. La tasa (0/5/10) va en un campo aparte (dTasaIVA)
/// porque un mismo codigo de afectacion admite mas de una tasa.
enum AfectacionIVA {
  GRAVADO // 1 = Gravado IVA
  EXONERADO // 2 = Exonerado (Art. 83-125)
  EXENTO // 3 = Exento
  GRAVADO_PARCIAL // 4 = Gravado parcial (ej. reventa de usados, liquida IVA sobre una proporcion)
}

enum TipoMovimientoStock {
  COMPRA
  VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  DEVOLUCION_COMPRA
  DEVOLUCION_VENTA
  INVENTARIO_INICIAL
}

enum TipoMovimientoCuentaCorriente {
  DEBITO // aumenta lo que el tercero nos debe (venta a credito, cargo)
  CREDITO // disminuye la deuda (cobro, nota de credito)
}

enum CondicionVenta {
  CONTADO
  CREDITO
}

/// E641 iCondCred (Manual Tecnico SIFEN v150, pag. 84) -- obligatorio
/// cuando la condicion de venta es CREDITO.
enum CondicionCredito {
  PLAZO
  CUOTA
}

/// Catalogo oficial de formas de pago (campo E606 iTiPago, Manual Tecnico SIFEN
/// v150, pag. 81). Numeracion 1-21 + 99=Otro; se conserva el orden oficial.
enum FormaPago {
  EFECTIVO // 1
  CHEQUE // 2
  TARJETA_CREDITO // 3
  TARJETA_DEBITO // 4
  TRANSFERENCIA // 5
  GIRO // 6
  BILLETERA_ELECTRONICA // 7
  TARJETA_EMPRESARIAL // 8
  VALE // 9
  RETENCION // 10
  PAGO_ANTICIPO // 11
  VALOR_FISCAL // 12
  VALOR_COMERCIAL // 13
  COMPENSACION // 14
  PERMUTA // 15
  PAGO_BANCARIO // 16
  PAGO_MOVIL // 17
  DONACION // 18
  PROMOCION // 19
  CONSUMO_INTERNO // 20
  PAGO_ELECTRONICO // 21
  OTRO // 99
}

/// Motivo de emision de Nota de Credito / Debito (campo E401 iMotEmi, Manual
/// Tecnico SIFEN v150, pag. 77). Catalogo cerrado, no texto libre.
enum MotivoEmisionNotaCD {
  DEVOLUCION_Y_AJUSTE_PRECIOS // 1
  DEVOLUCION // 2
  DESCUENTO // 3
  BONIFICACION // 4
  CREDITO_INCOBRABLE // 5
  RECUPERO_DE_COSTO // 6
  RECUPERO_DE_GASTO // 7
  AJUSTE_DE_PRECIO // 8
}

/// Regimen aduanero/especial opcional del emisor (campo D104 cTipReg / Tabla 1
/// del Manual Tecnico SIFEN v150, pag. 210). Distinto del regimen IRE ante la
/// SET (ver RegimenTributario) -- este solo aplica si la empresa opera bajo
/// alguno de estos regimenes especiales; la mayoria de contribuyentes no
/// informa este campo.
enum RegimenEspecialSifen {
  TURISMO // 1
  IMPORTADOR // 2
  EXPORTADOR // 3
  MAQUILA // 4
  LEY_60_90 // 5
  PEQUENO_PRODUCTOR // 6
  MEDIANO_PRODUCTOR // 7
  REGIMEN_CONTABLE // 8
}

/// Tipo de emision del DE (campo B002 iTipEmi). Forma parte de la
/// conformacion del CDC.
enum TipoEmisionDE {
  NORMAL // 1
  CONTINGENCIA // 2
}

/// Tipos de Documento Electronico segun SIFEN (e-Kuatia).
enum TipoDocumentoElectronico {
  FACTURA_ELECTRONICA
  AUTOFACTURA_ELECTRONICA
  NOTA_CREDITO_ELECTRONICA
  NOTA_DEBITO_ELECTRONICA
  NOTA_REMISION_ELECTRONICA
  COMPROBANTE_RETENCION_ELECTRONICO
}

enum EstadoComprobante {
  BORRADOR
  EMITIDO
  ANULADO
}

enum EstadoSesionCaja {
  ABIERTA
  CERRADA
}

/// Ciclo de vida del DE ante SIFEN.
enum EstadoDocumentoElectronico {
  BORRADOR
  PENDIENTE_ENVIO
  ENVIADO
  APROBADO
  APROBADO_CON_OBSERVACION
  RECHAZADO
  CANCELADO
  INUTILIZADO
}

enum TipoEventoDocumentoElectronico {
  CANCELACION
  INUTILIZACION
  CONFORMIDAD
  DISCONFORMIDAD
  DESCONOCIMIENTO
  NOTIFICACION
  NOMINACION // asigna a un receptor identificado una Factura Electronica emitida como innominado (NT_E_KUATIA 014, vigente desde 2024)
}

// ─────────────────────────────────────────────────────────────────────────
// 1. EMPRESA / ESTRUCTURA FISCAL / USUARIOS
// ─────────────────────────────────────────────────────────────────────────

model Empresa {
  id                     String                @id @default(cuid())
  ruc                    String                @unique
  dvRuc                  String // digito verificador del RUC
  razonSocial            String
  nombreFantasia         String?
  tipoContribuyente      TipoContribuyente
  regimenTributario      RegimenTributario     @default(IRE_GENERAL)
  regimenEspecialSifen   RegimenEspecialSifen? // solo si opera bajo un regimen especial (Tabla 1 SIFEN); la mayoria lo deja vacio
  direccion              String
  ciudad                 String
  departamento           String
  telefono               String?
  email                  String?
  logoUrl                String?
  activo                 Boolean               @default(true)
  // Recibo no es un Documento Electronico SIFEN (no usa timbrado), pero
  // igual necesita numeracion correlativa propia -- un contador simple por
  // empresa alcanza, sin la jerarquia de establecimiento/punto de expedicion.
  proximoNumeroRecibo    Int                   @default(1)
  // Orden de Pago (pago a proveedor): mismo criterio que Recibo, serie
  // correlativa propia por empresa, tampoco es un documento SIFEN.
  proximoNumeroOrdenPago Int                   @default(1)
  // Correlativo del Libro Diario -- mismo criterio simple que el de Recibo
  // (no es un documento SIFEN, solo necesita ser unico y consecutivo).
  proximoNumeroAsiento   Int                   @default(1)
  // Mapeo de "roles" contables (que cuenta usar para Caja, Clientes, Ventas,
  // IVA Debito Fiscal, Costo de Venta, Inventario...) a un id de
  // CuentaContable. Se guarda como JSON en vez de columnas/relaciones fijas
  // por cuenta para poder agregar roles nuevos sin migracion; las claves
  // validas viven en src/contabilidad/mapeo-contable.ts (CUENTA_ROL).
  mapeoContable          Json?
  // Fecha de cierre de periodo contable: ningun asiento (manual o
  // automatico de Venta/Cobro/Compra/Pago) puede postear con fecha igual o
  // anterior a esta. Null = sin cierre, cualquier fecha vale (estado por
  // defecto).
  fechaCierreContable    DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  establecimientos  Establecimiento[]
  usuarios          Usuario[]
  terceros          Tercero[]
  productos         Producto[]
  categorias        CategoriaProducto[]
  depositos         Deposito[]
  comprobantes      Comprobante[]
  condicionesPago   CondicionPago[]
  roles             Rol[]
  recibos           Recibo[]
  ordenesPago       OrdenPago[]
  sesionesCaja      SesionCaja[]
  compras           Compra[]
  cuentasContables  CuentaContable[]    @relation("EmpresaCuentas")
  asientosContables AsientoContable[]   @relation("EmpresaAsientos")
  cuentasBancarias  CuentaBancaria[]

  @@map("empresas")
}

model Establecimiento {
  id           String   @id @default(cuid())
  empresaId    String
  codigo       String // "001" — 3 digitos segun SIFEN
  nombre       String
  direccion    String
  ciudad       String
  departamento String
  telefono     String?
  email        String?
  esCasaMatriz Boolean  @default(false)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa          Empresa           @relation(fields: [empresaId], references: [id])
  puntosExpedicion PuntoExpedicion[]
  depositos        Deposito[]

  @@unique([empresaId, codigo])
  @@map("establecimientos")
}

model PuntoExpedicion {
  id                String   @id @default(cuid())
  establecimientoId String
  codigo            String // "001" — 3 digitos segun SIFEN
  descripcion       String
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  timbrados       Timbrado[]
  comprobantes    Comprobante[]
  sesionesCaja    SesionCaja[]

  @@unique([establecimientoId, codigo])
  @@map("puntos_expedicion")
}

model Timbrado {
  id                  String                   @id @default(cuid())
  puntoExpedicionId   String
  numeroTimbrado      String // 8 digitos otorgados por la SET
  tipoDocumento       TipoDocumentoElectronico
  // false = timbrado tradicional (preimpreso/virtual, sin DTE): el
  // comprobante es solo numerado, sin las exigencias de SIFEN (CDC, firma
  // digital, bloques de transporte/vendedor, motivo de emision, etc).
  // Conviven ambos regimenes dentro de una misma empresa segun el timbrado.
  esElectronico       Boolean                  @default(true)
  numeroDesde         Int
  numeroHasta         Int
  proximoNumero       Int                      @default(1)
  fechaInicioVigencia DateTime
  fechaFinVigencia    DateTime?
  activo              Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  puntoExpedicion PuntoExpedicion @relation(fields: [puntoExpedicionId], references: [id])
  comprobantes    Comprobante[]

  @@map("timbrados")
}

// Nivel de acceso del rol: ADMIN entra a configuracion (Empresa,
// Establecimientos, Timbrados, Usuarios); OPERADOR solo a las pantallas
// operativas del dia a dia (Facturacion, Compras, Stock, etc.).
enum RolTipo {
  ADMIN
  OPERADOR
}

// Secciones operativas restringibles por usuario (ver Usuario.modulosPermitidos).
// Configuracion (Usuarios, Empresas, Timbrados, etc.) no entra aca -- ya esta
// cerrada a ADMIN/superadmin por @Roles('ADMIN').
enum Modulo {
  VENTAS
  COMPRAS
  INVENTARIO
  CONTABILIDAD
}

// Pantallas puntuales dentro de cada modulo (ver Usuario.pantallasPermitidas).
// Es un segundo nivel de restriccion, mas fino que Modulo: un operador puede
// tener acceso al modulo Ventas pero solo a Punto de venta, por ejemplo.
enum Pantalla {
  PUNTO_DE_VENTA
  FACTURACION
  COMPROBANTES_EMITIDOS
  CLIENTES
  CUENTAS_CORRIENTES
  PROVEEDORES
  COMPROBANTES_COMPRA
  PRODUCTOS
  STOCK
  CONTABILIDAD
  BANCOS
}

model Rol {
  id        String   @id @default(cuid())
  empresaId String
  nombre    String
  tipo      RolTipo  @default(OPERADOR)
  permisos  Json // lista de permisos/acciones habilitadas (sin uso todavia)
  createdAt DateTime @default(now())

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  usuarios Usuario[]

  @@unique([empresaId, nombre])
  @@map("roles")
}

model Usuario {
  id                         String     @id @default(cuid())
  empresaId                  String
  rolId                      String
  nombre                     String
  email                      String     @unique
  passwordHash               String
  activo                     Boolean    @default(true)
  // Administra CUALQUIER empresa, no solo la propia (empresaId/rolId siguen
  // siendo su "casa" nominal, pero RolesGuard/TenantGuard lo dejan pasar en
  // todas). Reservado al operador de la plataforma -- las empresas de
  // clientes nunca deberian tener un usuario con esto en true.
  esSuperAdmin               Boolean    @default(false)
  // Vacio (default) = sin restriccion, ve todos los modulos que su RolTipo
  // permita -- asi ningun operador existente pierde acceso al agregar esto.
  // Solo se evalua para OPERADOR; ADMIN y superadmin siempre ven todo.
  modulosPermitidos          Modulo[]   @default([])
  // Vacio (default) = sin restriccion, opera en cualquier punto de
  // expedicion de la empresa. Si tiene valores, solo puede emitir/ver
  // comprobantes y abrir caja en esos puntos de expedicion puntuales.
  // Solo se evalua para OPERADOR; ADMIN y superadmin no se restringen.
  puntosExpedicionPermitidos String[]   @default([])
  // Vacio (default) = sin restriccion adicional, opera en cualquier
  // pantalla del modulo que tenga permitido. Si tiene valores, se acota
  // ademas a esas pantallas puntuales (ej. Ventas pero solo Punto de venta).
  // Solo se evalua para OPERADOR; ADMIN y superadmin no se restringen.
  pantallasPermitidas        Pantalla[] @default([])
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  sesionesCajaAbiertas SesionCaja[] @relation("SesionCajaApertura")
  sesionesCajaCerradas SesionCaja[] @relation("SesionCajaCierre")

  @@map("usuarios")
}

// ─────────────────────────────────────────────────────────────────────────
// 2. TERCEROS (Clientes y Proveedores)
// ─────────────────────────────────────────────────────────────────────────

model Tercero {
  id                String                 @id @default(cuid())
  empresaId         String
  tipo              TipoTercero
  tipoDocumento     TipoDocumentoIdentidad
  numeroDocumento   String // RUC o CI
  dvRuc             String?
  razonSocial       String // nombre completo o razon social
  nombreFantasia    String?
  tipoContribuyente TipoContribuyente?
  direccion         String?
  ciudad            String?
  departamento      String?
  pais              String                 @default("PY")
  telefono          String?
  email             String?
  condicionPagoId   String?
  limiteCredito     Decimal?               @db.Decimal(15, 2)
  activo            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  empresa                   Empresa           @relation(fields: [empresaId], references: [id])
  condicionPago             CondicionPago?    @relation(fields: [condicionPagoId], references: [id])
  contactos                 ContactoTercero[]
  cuentaCorriente           CuentaCorriente?
  comprobantesComoCliente   Comprobante[]     @relation("ComprobanteCliente")
  comprobantesComoProveedor Comprobante[]     @relation("ComprobanteProveedor")
  recibos                   Recibo[]
  compras                   Compra[]
  ordenesPago               OrdenPago[]

  // El mismo RUC puede existir como Cliente y como Proveedor a la vez (son
  // roles distintos en el sistema) -- por eso "tipo" entra en la clave unica,
  // no solo empresaId+tipoDocumento+numeroDocumento.
  @@unique([empresaId, tipo, tipoDocumento, numeroDocumento])
  @@index([empresaId, razonSocial])
  @@map("terceros")
}

model ContactoTercero {
  id        String   @id @default(cuid())
  terceroId String
  nombre    String
  cargo     String?
  telefono  String?
  email     String?
  createdAt DateTime @default(now())

  tercero Tercero @relation(fields: [terceroId], references: [id])

  @@map("contactos_tercero")
}

// ─────────────────────────────────────────────────────────────────────────
// 3. PRODUCTOS Y STOCK
// ─────────────────────────────────────────────────────────────────────────

model CategoriaProducto {
  id               String   @id @default(cuid())
  empresaId        String
  nombre           String
  categoriaPadreId String?
  createdAt        DateTime @default(now())

  empresa        Empresa             @relation(fields: [empresaId], references: [id])
  categoriaPadre CategoriaProducto?  @relation("SubCategorias", fields: [categoriaPadreId], references: [id])
  subcategorias  CategoriaProducto[] @relation("SubCategorias")
  productos      Producto[]

  @@map("categorias_producto")
}

model UnidadMedida {
  id          String @id @default(cuid())
  codigoSifen String @unique // codigo del catalogo de unidades de medida SIFEN (ej "77" = Unidad)
  descripcion String

  productos        Producto[]
  comprobanteItems ComprobanteItem[]

  @@map("unidades_medida")
}

model Producto {
  id             String        @id @default(cuid())
  empresaId      String
  codigo         String // SKU interno
  codigoBarra    String?
  descripcion    String
  categoriaId    String?
  unidadMedidaId String
  afectacionIva  AfectacionIVA @default(GRAVADO)
  tasaIva        Int           @default(10) // 0, 5 o 10 -- ver E734 dTasaIVA; 0 si afectacionIva es EXENTO/EXONERADO
  precioCosto    Decimal       @db.Decimal(15, 2)
  precioVenta    Decimal       @db.Decimal(15, 2)
  controlaStock  Boolean       @default(true)
  stockMinimo    Decimal?      @db.Decimal(15, 3)
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  categoria        CategoriaProducto? @relation(fields: [categoriaId], references: [id])
  unidadMedida     UnidadMedida       @relation(fields: [unidadMedidaId], references: [id])
  stocks           Stock[]
  movimientos      MovimientoStock[]
  comprobanteItems ComprobanteItem[]

  @@unique([empresaId, codigo])
  @@index([empresaId, descripcion])
  @@map("productos")
}

model Deposito {
  id                String   @id @default(cuid())
  empresaId         String
  establecimientoId String?
  nombre            String
  direccion         String?
  esPrincipal       Boolean  @default(false)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())

  empresa            Empresa           @relation(fields: [empresaId], references: [id])
  establecimiento    Establecimiento?  @relation(fields: [establecimientoId], references: [id])
  stocks             Stock[]
  movimientosOrigen  MovimientoStock[] @relation("DepositoOrigen")
  movimientosDestino MovimientoStock[] @relation("DepositoDestino")

  @@map("depositos")
}

model Stock {
  id         String   @id @default(cuid())
  productoId String
  depositoId String
  cantidad   Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt  DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id])
  deposito Deposito @relation(fields: [depositoId], references: [id])

  @@unique([productoId, depositoId])
  @@map("stock")
}

/// Kardex: registro inmutable de todo movimiento de stock, con saldo resultante.
model MovimientoStock {
  id                String              @id @default(cuid())
  productoId        String
  depositoId        String
  depositoDestinoId String? // solo para TRANSFERENCIA_SALIDA / TRANSFERENCIA_ENTRADA
  tipo              TipoMovimientoStock
  cantidad          Decimal             @db.Decimal(15, 3)
  cantidadAnterior  Decimal             @db.Decimal(15, 3)
  cantidadNueva     Decimal             @db.Decimal(15, 3)
  costoUnitario     Decimal?            @db.Decimal(15, 2)
  comprobanteId     String?
  fecha             DateTime            @default(now())
  usuarioId         String?
  observacion       String?

  producto        Producto     @relation(fields: [productoId], references: [id])
  deposito        Deposito     @relation("DepositoOrigen", fields: [depositoId], references: [id])
  depositoDestino Deposito?    @relation("DepositoDestino", fields: [depositoDestinoId], references: [id])
  comprobante     Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@index([productoId, depositoId, fecha])
  @@map("movimientos_stock")
}

// ─────────────────────────────────────────────────────────────────────────
// 4. CUENTAS CORRIENTES
// ─────────────────────────────────────────────────────────────────────────

model CondicionPago {
  id             String   @id @default(cuid())
  empresaId      String
  nombre         String // ej "Contado", "30 dias", "3 cuotas 30-60-90"
  diasPlazo      Int      @default(0)
  cantidadCuotas Int      @default(1)
  createdAt      DateTime @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  terceros     Tercero[]
  comprobantes Comprobante[]

  @@map("condiciones_pago")
}

/// Una cuenta corriente por tercero, con saldo denormalizado para lectura rapida
/// (el saldo se recalcula/verifica a partir de MovimientoCuentaCorriente).
model CuentaCorriente {
  id            String   @id @default(cuid())
  terceroId     String   @unique
  saldo         Decimal  @default(0) @db.Decimal(15, 2) // positivo = el tercero nos debe
  limiteCredito Decimal? @db.Decimal(15, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tercero     Tercero                     @relation(fields: [terceroId], references: [id])
  movimientos MovimientoCuentaCorriente[]

  @@map("cuentas_corrientes")
}

model MovimientoCuentaCorriente {
  id                String                        @id @default(cuid())
  cuentaCorrienteId String
  tipo              TipoMovimientoCuentaCorriente
  monto             Decimal                       @db.Decimal(15, 2)
  saldoAnterior     Decimal                       @db.Decimal(15, 2)
  saldoNuevo        Decimal                       @db.Decimal(15, 2)
  concepto          String
  comprobanteId     String?
  compraId          String?
  reciboId          String?
  ordenPagoId       String?
  fecha             DateTime                      @default(now())
  fechaVencimiento  DateTime?
  usuarioId         String?

  cuentaCorriente CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])
  comprobante     Comprobante?    @relation(fields: [comprobanteId], references: [id])
  compra          Compra?         @relation(fields: [compraId], references: [id])
  recibo          Recibo?         @relation(fields: [reciboId], references: [id])
  ordenPago       OrdenPago?      @relation(fields: [ordenPagoId], references: [id])

  @@index([cuentaCorrienteId, fecha])
  @@map("movimientos_cuenta_corriente")
}

/// Recibo de cobro/pago, aplicable a uno o varios comprobantes (pagos parciales o combinados).
model Recibo {
  id               String    @id @default(cuid())
  empresaId        String
  terceroId        String
  numero           String
  fecha            DateTime  @default(now())
  monto            Decimal   @db.Decimal(15, 2)
  formaPago        FormaPago
  observacion      String?
  // Solo se completa cuando el cobro entra por una cuenta bancaria real
  // (transferencia, deposito, etc.) -- si esta presente, se genera un
  // MovimientoBancario CREDITO enlazado para que aparezca en Bancos listo
  // para conciliar. No reemplaza el asiento contable automatico (que sigue
  // usando el rol generico "BANCO" del mapeo contable).
  cuentaBancariaId String?
  createdAt        DateTime  @default(now())

  empresa            Empresa                     @relation(fields: [empresaId], references: [id])
  tercero            Tercero                     @relation(fields: [terceroId], references: [id])
  cuentaBancaria     CuentaBancaria?             @relation(fields: [cuentaBancariaId], references: [id])
  aplicaciones       ReciboAplicacion[]
  movimientosCC      MovimientoCuentaCorriente[]
  asientosContables  AsientoContable[]
  movimientoBancario MovimientoBancario?

  @@unique([empresaId, numero])
  @@map("recibos")
}

model ReciboAplicacion {
  id            String  @id @default(cuid())
  reciboId      String
  comprobanteId String
  montoAplicado Decimal @db.Decimal(15, 2)

  recibo      Recibo      @relation(fields: [reciboId], references: [id])
  comprobante Comprobante @relation(fields: [comprobanteId], references: [id])

  @@map("recibo_aplicaciones")
}

/// Orden de pago a un proveedor -- espejo de Recibo (cobro), aplicable a
/// una o varias Compras pendientes (pagos parciales o combinados).
model OrdenPago {
  id               String    @id @default(cuid())
  empresaId        String
  proveedorId      String
  numero           String
  fecha            DateTime  @default(now())
  monto            Decimal   @db.Decimal(15, 2)
  formaPago        FormaPago
  observacion      String?
  // Solo se completa cuando el pago sale por una cuenta bancaria real
  // (transferencia, cheque, etc.) -- si esta presente, se genera un
  // MovimientoBancario DEBITO enlazado. Si se deja vacio, se asume que
  // salio de Caja (efectivo).
  cuentaBancariaId String?
  createdAt        DateTime  @default(now())

  empresa            Empresa                     @relation(fields: [empresaId], references: [id])
  proveedor          Tercero                     @relation(fields: [proveedorId], references: [id])
  cuentaBancaria     CuentaBancaria?             @relation(fields: [cuentaBancariaId], references: [id])
  aplicaciones       OrdenPagoAplicacion[]
  movimientosCC      MovimientoCuentaCorriente[]
  asientosContables  AsientoContable[]
  movimientoBancario MovimientoBancario?

  @@unique([empresaId, numero])
  @@map("ordenes_pago")
}

model OrdenPagoAplicacion {
  id            String  @id @default(cuid())
  ordenPagoId   String
  compraId      String
  montoAplicado Decimal @db.Decimal(15, 2)

  ordenPago OrdenPago @relation(fields: [ordenPagoId], references: [id])
  compra    Compra    @relation(fields: [compraId], references: [id])

  @@map("orden_pago_aplicaciones")
}

// ─────────────────────────────────────────────────────────────────────────
// 5. COMPROBANTES DE VENTA/COMPRA + DOCUMENTO ELECTRONICO (SIFEN)
// ─────────────────────────────────────────────────────────────────────────

/// Turno de caja del Punto de Venta (POS): agrupa las ventas hechas por un
/// cajero entre la apertura (monto inicial declarado) y el cierre (arqueo:
/// efectivo contado vs. lo que deberia haber segun las ventas en efectivo
/// del turno). No es un concepto de SIFEN -- es control interno del negocio.
model SesionCaja {
  id                String  @id @default(cuid())
  empresaId         String
  puntoExpedicionId String
  usuarioAperturaId String
  usuarioCierreId   String?

  montoInicial        Decimal  @db.Decimal(15, 2)
  // Se completan recien al cerrar -- ver CajaService.cerrarSesion().
  montoFinalDeclarado Decimal? @db.Decimal(15, 2) // lo que el cajero contó físicamente
  montoFinalCalculado Decimal? @db.Decimal(15, 2) // montoInicial + ventas en efectivo del turno
  diferencia          Decimal? @db.Decimal(15, 2) // declarado - calculado (sobrante/faltante)

  estado            EstadoSesionCaja @default(ABIERTA)
  fechaApertura     DateTime         @default(now())
  fechaCierre       DateTime?
  observacionCierre String?

  empresa         Empresa         @relation(fields: [empresaId], references: [id])
  puntoExpedicion PuntoExpedicion @relation(fields: [puntoExpedicionId], references: [id])
  usuarioApertura Usuario         @relation("SesionCajaApertura", fields: [usuarioAperturaId], references: [id])
  usuarioCierre   Usuario?        @relation("SesionCajaCierre", fields: [usuarioCierreId], references: [id])
  ventas          Comprobante[]

  @@map("sesiones_caja")
}

model Comprobante {
  id                String                   @id @default(cuid())
  empresaId         String
  puntoExpedicionId String
  timbradoId        String
  tipoDocumento     TipoDocumentoElectronico
  numero            String // correlativo de 7 digitos dentro del timbrado
  fechaEmision      DateTime                 @default(now())

  clienteId   String? // para ventas
  proveedorId String? // para compras / autofactura

  condicionVenta   CondicionVenta    @default(CONTADO)
  condicionPagoId  String?
  // E641/E643/E644 (Manual Tecnico SIFEN v150, pag. 84) -- obligatorios
  // cuando condicionVenta = CREDITO: si es a Plazo se informa plazoCredito
  // ("30 dias", "12 meses"), si es a Cuota se informa cantidadCuotas.
  condicionCredito CondicionCredito?
  plazoCredito     String?
  cantidadCuotas   Int?
  moneda           String            @default("PYG")
  tipoCambio       Decimal?          @db.Decimal(15, 4)

  subtotalExenta    Decimal @default(0) @db.Decimal(15, 2)
  subtotalGravada10 Decimal @default(0) @db.Decimal(15, 2)
  subtotalGravada5  Decimal @default(0) @db.Decimal(15, 2)
  iva10             Decimal @default(0) @db.Decimal(15, 2)
  iva5              Decimal @default(0) @db.Decimal(15, 2)
  total             Decimal @db.Decimal(15, 2)

  comprobanteAsociadoId String? // NC/ND referenciando la factura original
  motivoEmision         MotivoEmisionNotaCD? // obligatorio si tipoDocumento es NC/ND (catalogo cerrado SIFEN)

  // Si la venta se emitio desde el Punto de Venta (POS), queda asociada a la
  // sesion de caja abierta en ese momento -- asi el cierre de caja puede
  // sumar el efectivo esperado. Las facturas cargadas desde el flujo de
  // Facturacion normal no pasan por una sesion y quedan en null.
  sesionCajaId String?

  estado      EstadoComprobante @default(BORRADOR)
  observacion String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  empresa                  Empresa         @relation(fields: [empresaId], references: [id])
  puntoExpedicion          PuntoExpedicion @relation(fields: [puntoExpedicionId], references: [id])
  timbrado                 Timbrado        @relation(fields: [timbradoId], references: [id])
  cliente                  Tercero?        @relation("ComprobanteCliente", fields: [clienteId], references: [id])
  proveedor                Tercero?        @relation("ComprobanteProveedor", fields: [proveedorId], references: [id])
  condicionPago            CondicionPago?  @relation(fields: [condicionPagoId], references: [id])
  comprobanteAsociado      Comprobante?    @relation("ComprobantesRelacionados", fields: [comprobanteAsociadoId], references: [id])
  comprobantesRelacionados Comprobante[]   @relation("ComprobantesRelacionados")
  sesionCaja               SesionCaja?     @relation(fields: [sesionCajaId], references: [id])

  items                      ComprobanteItem[]
  documentoElectronico       DocumentoElectronico?
  movimientosStock           MovimientoStock[]
  movimientosCuentaCorriente MovimientoCuentaCorriente[]
  pagos                      ComprobantePago[]
  reciboAplicaciones         ReciboAplicacion[]
  asientosContables          AsientoContable[]
  datosTransporteRemision    DatosTransporteRemision?
  datosVendedorAutofactura   DatosVendedorAutofactura?

  // La numeracion es propia de cada timbrado, no del par puntoExpedicion+tipo
  // -- dos timbrados del mismo tipo de documento (ej. uno electronico y otro
  // tradicional, o uno vencido y su reemplazo) arrancan cada uno en su propio
  // rango, y pueden perfectamente coincidir en el mismo numero visible.
  @@unique([timbradoId, numero])
  @@index([empresaId, fechaEmision])
  @@map("comprobantes")
}

model ComprobanteItem {
  id                String        @id @default(cuid())
  comprobanteId     String
  productoId        String?
  descripcion       String
  cantidad          Decimal       @db.Decimal(15, 3)
  unidadMedidaId    String
  precioUnitario    Decimal       @db.Decimal(15, 2)
  descuento         Decimal       @default(0) @db.Decimal(15, 2)
  afectacionIva     AfectacionIVA
  tasaIva           Int           @default(10) // 0, 5 o 10 -- ver E734 dTasaIVA
  proporcionGravada Decimal?      @db.Decimal(5, 2) // solo si afectacionIva = GRAVADO_PARCIAL (E733 dPropIVA)
  montoExenta       Decimal       @default(0) @db.Decimal(15, 2)
  montoGravado      Decimal       @default(0) @db.Decimal(15, 2)
  liquidacionIva    Decimal       @default(0) @db.Decimal(15, 2)
  total             Decimal       @db.Decimal(15, 2)
  // Snapshot del precioCosto del producto al momento de la venta -- asi el
  // reporte de rentabilidad no queda mal si despues cambia el costo del
  // producto. Null en items libres (sin productoId) o si el producto no
  // tenia costo cargado.
  costoUnitario     Decimal?      @db.Decimal(15, 2)

  comprobante  Comprobante  @relation(fields: [comprobanteId], references: [id])
  producto     Producto?    @relation(fields: [productoId], references: [id])
  unidadMedida UnidadMedida @relation(fields: [unidadMedidaId], references: [id])

  @@map("comprobante_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Datos de transporte de la Nota de Remision Electronica -- grupos E6/E10
// del Manual Tecnico SIFEN v150 (obligatorios cuando C002=7). Se modela
// aparte del Comprobante (en vez de columnas sueltas ahi) porque son ~20
// campos que solo aplican a este unico tipo de documento.
// ─────────────────────────────────────────────────────────────────────────

/// E501 iMotEmiNR (Manual Tecnico SIFEN v150, pag. 78)
enum MotivoEmisionNotaRemision {
  TRASLADO_POR_VENTA
  TRASLADO_POR_CONSIGNACION
  EXPORTACION
  TRASLADO_POR_COMPRA
  IMPORTACION
  TRASLADO_POR_DEVOLUCION
  TRASLADO_ENTRE_LOCALES
  TRASLADO_POR_TRANSFORMACION
  TRASLADO_POR_REPARACION
  TRASLADO_POR_EMISOR_MOVIL
  EXHIBICION_O_DEMOSTRACION
  PARTICIPACION_EN_FERIAS
  TRASLADO_DE_ENCOMIENDA
  DECOMISO
  OTRO
}

/// E503 iRespEmiNR
enum ResponsableEmisionNotaRemision {
  EMISOR_FACTURA
  POSEEDOR_FACTURA_Y_BIENES
  EMPRESA_TRANSPORTISTA
  DESPACHANTE_ADUANAS
  AGENTE_TRANSPORTE
}

/// E901 iTipTrans
enum TipoTransporte {
  PROPIO
  TERCERO
}

/// E903 iModTrans
enum ModalidadTransporte {
  TERRESTRE
  FLUVIAL
  AEREO
  MULTIMODAL
}

/// E905 iRespFlete
enum ResponsableFlete {
  EMISOR_FACTURA
  RECEPTOR_FACTURA
  TERCERO
  AGENTE_INTERMEDIARIO
  TRANSPORTE_PROPIO
}

/// E967 dTipIdenVeh
enum TipoIdentificacionVehiculo {
  NUMERO_IDENTIFICACION
  MATRICULA
}

/// E981 iNatTrans
enum NaturalezaTransportista {
  CONTRIBUYENTE
  NO_CONTRIBUYENTE
}

model DatosTransporteRemision {
  id            String @id @default(cuid())
  comprobanteId String @unique

  // E6 -- motivo y responsable de la emision de la remision
  motivoEmision             MotivoEmisionNotaRemision
  motivoEmisionOtro         String? // obligatorio si motivoEmision = OTRO (E501=99)
  responsableEmision        ResponsableEmisionNotaRemision
  kmEstimados               Int?
  fechaEmisionFacturaFutura DateTime? // E506, cuando la factura todavia no se emitio

  // E10 -- transporte
  tipoTransporte      TipoTransporte
  modalidadTransporte ModalidadTransporte
  responsableFlete    ResponsableFlete
  fechaInicioTraslado DateTime
  fechaFinTraslado    DateTime

  // E10.1 -- local de salida
  direccionSalida    String
  numeroCasaSalida   String
  ciudadSalida       String
  departamentoSalida String

  // E10.2 -- local de entrega
  direccionEntrega    String
  numeroCasaEntrega   String
  ciudadEntrega       String
  departamentoEntrega String

  // E10.3 -- vehiculo (el manual permite hasta 4, se soporta uno solo por
  // simplicidad -- cubre el caso de uso real de una PyME)
  tipoVehiculo                 String
  marcaVehiculo                String
  tipoIdentificacionVehiculo   TipoIdentificacionVehiculo
  numeroIdentificacionVehiculo String? // obligatorio si tipoIdentificacionVehiculo = NUMERO_IDENTIFICACION
  numeroMatriculaVehiculo      String? // obligatorio si tipoIdentificacionVehiculo = MATRICULA
  numeroVuelo                  String? // obligatorio si modalidadTransporte = AEREO

  // E10.4 -- transportista y chofer
  naturalezaTransportista         NaturalezaTransportista
  nombreTransportista             String
  rucTransportista                String? // obligatorio si naturalezaTransportista = CONTRIBUYENTE
  dvRucTransportista              String?
  tipoDocIdentidadTransportista   TipoDocumentoIdentidad? // obligatorio si naturalezaTransportista = NO_CONTRIBUYENTE
  numeroDocIdentidadTransportista String?
  numeroDocIdentidadChofer        String
  nombreChofer                    String

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id])

  @@map("datos_transporte_remision")
}

/// E301 iNatVen
enum NaturalezaVendedorAutofactura {
  NO_CONTRIBUYENTE
  EXTRANJERO
}

model DatosVendedorAutofactura {
  id            String @id @default(cuid())
  comprobanteId String @unique

  // E4 -- datos del vendedor (E300-E315)
  naturalezaVendedor         NaturalezaVendedorAutofactura
  tipoDocIdentidadVendedor   TipoDocumentoIdentidad
  numeroDocIdentidadVendedor String
  nombreVendedor             String
  direccionVendedor          String
  numeroCasaVendedor         String
  ciudadVendedor             String
  departamentoVendedor       String

  // E4 -- lugar donde se realizo la transaccion (E316-E322), relevante
  // sobre todo cuando el vendedor es extranjero
  direccionTransaccion    String
  ciudadTransaccion       String
  departamentoTransaccion String

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id])

  @@map("datos_vendedor_autofactura")
}

model ComprobantePago {
  id               String    @id @default(cuid())
  comprobanteId    String
  formaPago        FormaPago
  monto            Decimal   @db.Decimal(15, 2)
  banco            String?
  numeroCheque     String?
  fecha            DateTime  @default(now())
  // Cuenta bancaria puntual que recibió el pago (cuando formaPago es
  // bancaria) -- distinta del campo "banco" de arriba, que es solo texto
  // libre para el dato informativo de SIFEN. Con esto el pago genera su
  // MovimientoBancario y postea al Plan de Cuentas de ese banco especifico.
  cuentaBancariaId String?

  comprobante        Comprobante         @relation(fields: [comprobanteId], references: [id])
  cuentaBancaria     CuentaBancaria?     @relation(fields: [cuentaBancariaId], references: [id])
  movimientoBancario MovimientoBancario?

  @@map("comprobante_pagos")
}

/// Representacion del Documento Electronico (DE) enviado a SIFEN para un comprobante.
model DocumentoElectronico {
  id                    String                     @id @default(cuid())
  comprobanteId         String                     @unique
  cdc                   String                     @unique // Codigo de Control, 44 caracteres
  codigoSeguridad       String // 9 digitos aleatorios usados para generar el CDC
  tipoEmision           TipoEmisionDE              @default(NORMAL) // forma parte del CDC (campo B002)
  xmlGenerado           String?                    @db.Text
  xmlFirmado            String?                    @db.Text
  xmlRespuestaSet       String?                    @db.Text
  estado                EstadoDocumentoElectronico @default(BORRADOR)
  numeroLote            String?
  protocoloAutorizacion String?
  motivoRechazo         String?
  qrUrl                 String?
  fechaFirma            DateTime?
  fechaEnvio            DateTime?
  fechaProceso          DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  comprobante Comprobante                  @relation(fields: [comprobanteId], references: [id])
  eventos     EventoDocumentoElectronico[]

  @@map("documentos_electronicos")
}

model EventoDocumentoElectronico {
  id                     String                         @id @default(cuid())
  documentoElectronicoId String
  tipo                   TipoEventoDocumentoElectronico
  fecha                  DateTime                       @default(now())
  motivo                 String?
  xmlEvento              String?                        @db.Text
  xmlRespuesta           String?                        @db.Text
  createdAt              DateTime                       @default(now())

  documentoElectronico DocumentoElectronico @relation(fields: [documentoElectronicoId], references: [id])

  @@map("eventos_documento_electronico")
}

// ─────────────────────────────────────────────────────────────────────────
// Compras: registro manual de comprobantes que emiten los proveedores (no
// son documentos electronicos nuestros -- no usan Timbrado/numeracion
// propia, el numero de comprobante lo tipea el usuario tal como figura en
// la factura del proveedor). Existen principalmente para poder contabilizar
// gastos/compras (asiento automatico con IVA Credito Fiscal) y, si son a
// credito, sumar la deuda en la cuenta corriente del proveedor.
// ─────────────────────────────────────────────────────────────────────────

model Compra {
  id                String            @id @default(cuid())
  empresaId         String
  proveedorId       String
  numeroComprobante String // tal cual figura en la factura del proveedor
  timbradoProveedor String?
  fechaEmision      DateTime          @default(now())
  concepto          String
  cuentaContableId  String // cuenta de gasto/activo que corresponde (elegida del Plan de Cuentas)
  condicionCompra   CondicionVenta    @default(CONTADO)
  formaPago         FormaPago?
  montoExenta       Decimal           @default(0) @db.Decimal(15, 2)
  montoGravada10    Decimal           @default(0) @db.Decimal(15, 2)
  montoGravada5     Decimal           @default(0) @db.Decimal(15, 2)
  iva10             Decimal           @default(0) @db.Decimal(15, 2)
  iva5              Decimal           @default(0) @db.Decimal(15, 2)
  total             Decimal           @db.Decimal(15, 2)
  observacion       String?
  estado            EstadoComprobante @default(EMITIDO)
  createdAt         DateTime          @default(now())

  empresa           Empresa                     @relation(fields: [empresaId], references: [id])
  proveedor         Tercero                     @relation(fields: [proveedorId], references: [id])
  cuentaContable    CuentaContable              @relation(fields: [cuentaContableId], references: [id])
  asientosContables AsientoContable[]
  aplicacionesPago  OrdenPagoAplicacion[]
  movimientosCC     MovimientoCuentaCorriente[]

  @@map("compras")
}

// ─────────────────────────────────────────────────────────────────────────
// Contabilidad general (partida doble) -- Plan de Cuentas + Libro Diario.
// El Plan de Cuentas por defecto que se siembra por empresa sigue textual la
// codificacion del modelo oficial de Estados Financieros de la DNIT
// (Balance General / Estado de Resultado, Obligacion 948), para que el
// Estado de Variacion del Patrimonio Neto (reservas, resultados acumulados)
// que exige la RG 49/26 salga directo de estas cuentas sin tener que
// remapear nada despues.
// ─────────────────────────────────────────────────────────────────────────

enum TipoCuentaContable {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  EGRESO
}

enum NaturalezaCuenta {
  DEUDORA
  ACREEDORA
}

enum OrigenAsiento {
  MANUAL
  VENTA
  COBRO
  COMPRA
  PAGO
}

model CuentaContable {
  id            String             @id @default(cuid())
  empresaId     String
  codigo        String // jerarquico, ej "1-01-01-01" -- igual al Plan de Cuentas DNIT
  nombre        String
  tipo          TipoCuentaContable
  naturaleza    NaturalezaCuenta
  // false = cuenta "rubro"/encabezado (ej "1-01-01- DISPONIBILIDADES"), solo
  // agrupa subcuentas y no se le puede asentar directo -- asi el Libro Mayor
  // no mezcla totales de grupo con movimientos reales.
  imputable     Boolean            @default(true)
  cuentaPadreId String?
  activo        Boolean            @default(true)
  createdAt     DateTime           @default(now())

  empresa          Empresa                  @relation("EmpresaCuentas", fields: [empresaId], references: [id])
  cuentaPadre      CuentaContable?          @relation("JerarquiaCuentas", fields: [cuentaPadreId], references: [id])
  subcuentas       CuentaContable[]         @relation("JerarquiaCuentas")
  detalles         AsientoContableDetalle[]
  compras          Compra[]
  cuentasBancarias CuentaBancaria[]

  @@unique([empresaId, codigo])
  @@map("cuentas_contables")
}

model AsientoContable {
  id            String        @id @default(cuid())
  empresaId     String
  numero        Int // correlativo por empresa (folio del Libro Diario)
  fecha         DateTime      @default(now())
  concepto      String
  origen        OrigenAsiento @default(MANUAL)
  comprobanteId String? // presente si el asiento salio automatico de una venta
  reciboId      String? // presente si el asiento salio automatico de un cobro
  compraId      String? // presente si el asiento salio automatico de una compra
  ordenPagoId   String? // presente si el asiento salio automatico de un pago a proveedor
  createdAt     DateTime      @default(now())

  empresa     Empresa                  @relation("EmpresaAsientos", fields: [empresaId], references: [id])
  comprobante Comprobante?             @relation(fields: [comprobanteId], references: [id])
  recibo      Recibo?                  @relation(fields: [reciboId], references: [id])
  compra      Compra?                  @relation(fields: [compraId], references: [id])
  ordenPago   OrdenPago?               @relation(fields: [ordenPagoId], references: [id])
  detalles    AsientoContableDetalle[]

  @@unique([empresaId, numero])
  @@map("asientos_contables")
}

model AsientoContableDetalle {
  id        String  @id @default(cuid())
  asientoId String
  cuentaId  String
  debe      Decimal @default(0) @db.Decimal(15, 2)
  haber     Decimal @default(0) @db.Decimal(15, 2)
  glosa     String?

  asiento AsientoContable @relation(fields: [asientoId], references: [id])
  cuenta  CuentaContable  @relation(fields: [cuentaId], references: [id])

  @@map("asiento_contable_detalles")
}

enum TipoCuentaBancaria {
  CUENTA_CORRIENTE
  CAJA_AHORRO
}

enum TipoMovimientoBancario {
  DEBITO // egreso -- sale dinero de la cuenta
  CREDITO // ingreso -- entra dinero a la cuenta
}

model CuentaBancaria {
  id                String             @id @default(cuid())
  empresaId         String
  banco             String
  nombre            String // etiqueta propia, ej "Cta Cte USD Itau"
  numeroCuenta      String
  tipoCuenta        TipoCuentaBancaria @default(CUENTA_CORRIENTE)
  moneda            String             @default("PYG")
  // Cuenta del Plan de Cuentas que representa a este banco puntual -- a
  // diferencia del rol generico "BANCO" del mapeo contable (que asume una
  // sola cuenta de banco), cada cuenta bancaria real puede tener la suya.
  cuentaContableId  String
  saldoInicial      Decimal            @default(0) @db.Decimal(15, 2)
  fechaSaldoInicial DateTime
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  empresa          Empresa                @relation(fields: [empresaId], references: [id])
  cuentaContable   CuentaContable         @relation(fields: [cuentaContableId], references: [id])
  movimientos      MovimientoBancario[]
  conciliaciones   ConciliacionBancaria[]
  recibos          Recibo[]
  ordenesPago      OrdenPago[]
  comprobantePagos ComprobantePago[]

  @@unique([empresaId, numeroCuenta])
  @@map("cuentas_bancarias")
}

model MovimientoBancario {
  id                String                 @id @default(cuid())
  cuentaBancariaId  String
  fecha             DateTime
  concepto          String
  tipo              TipoMovimientoBancario
  monto             Decimal                @db.Decimal(15, 2)
  referencia        String? // nro de cheque, nro de operacion, etc.
  // Sin vinculo automatico a asientos contables (v1): es un registro propio
  // para cotejar contra el extracto, no genera contabilidad por si solo.
  conciliado        Boolean                @default(false)
  fechaConciliacion DateTime?
  // Si este movimiento se genero solo al registrar un cobro (Recibo) por
  // transferencia/deposito, queda enlazado aca -- permite mostrar el origen
  // en Bancos y evita generarlo dos veces para el mismo recibo.
  reciboId          String?                @unique
  // Idem, pero cuando el movimiento sale de una Orden de Pago a proveedor
  // (egreso) en vez de un cobro.
  ordenPagoId       String?                @unique
  // Idem, pero cuando el movimiento sale de un pago de venta al contado
  // (Comprobante) por transferencia/deposito.
  comprobantePagoId String?                @unique
  createdAt         DateTime               @default(now())

  cuentaBancaria  CuentaBancaria   @relation(fields: [cuentaBancariaId], references: [id])
  recibo          Recibo?          @relation(fields: [reciboId], references: [id])
  comprobantePago ComprobantePago? @relation(fields: [comprobantePagoId], references: [id])
  ordenPago       OrdenPago?       @relation(fields: [ordenPagoId], references: [id])

  @@map("movimientos_bancarios")
}

// Snapshot historico de cada cierre de conciliacion -- deja constancia de
// contra que saldo de extracto se concilio y que diferencia quedo, aunque
// despues seudan marcar/desmarcar movimientos individuales.
model ConciliacionBancaria {
  id               String   @id @default(cuid())
  cuentaBancariaId String
  fechaCorte       DateTime
  saldoLibros      Decimal  @db.Decimal(15, 2)
  saldoExtracto    Decimal  @db.Decimal(15, 2)
  diferencia       Decimal  @db.Decimal(15, 2)
  observacion      String?
  createdAt        DateTime @default(now())

  cuentaBancaria CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id])

  @@map("conciliaciones_bancarias")
}
